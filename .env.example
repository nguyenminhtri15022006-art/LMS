# ============================================================
# EduLearn LMS - Environment Configuration Template
# Sao chép file này thành .env trước khi chạy: cp .env.example .env
# ============================================================

# ============================================================
# Shared & Network Discovery
# ============================================================
EUREKA_URL=http://localhost:8761/eureka
FRONTEND_URL=http://localhost:5173

# ============================================================
# Timezone Configuration (Đồng bộ UTC trên toàn hệ thống)
# ============================================================
TZ=UTC
JAVA_TOOL_OPTIONS=-Duser.timezone=UTC
JACKSON_TIME_ZONE=UTC
HIBERNATE_JDBC_TIME_ZONE=UTC
MYSQL_SERVER_TIMEZONE=UTC
DB_TIME_ZONE=+00:00

# ============================================================
# Object Storage (MinIO Local S3 Compatible)
# ============================================================
MINIO_URL=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ============================================================
# Relational Database: MySQL 8.4 (Docker Compose Local)
# ============================================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=mysqladmin123
MYSQL_ROOT_HOST=%

# Tên database riêng biệt cho từng service (Database per Service)
IDENTITY_DB_NAME=identity_lms
COURSE_DB_NAME=course_lms
ASSIGNMENT_DB_NAME=assignment_lms
BLOG_DB_NAME=blog_lms

# ============================================================
# Document Database: MongoDB 7.0 (Docker Compose Local)
# ============================================================
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=mongoadmin123

# Tên database MongoDB riêng biệt
COURSE_MONGODB_DATABASE=course_lms_mongo
ASSIGNMENT_MONGODB_DATABASE=assignment_lms_mongo
CHATBOT_MONGODB_DATABASE=chatbot_db

# ============================================================
# Inter-Service Internal Communication URLs
# ============================================================
IDENTITY_SERVICE_URL=http://identity-service:8081/identity
COURSE_SERVICE_URL=http://course-service:8082/course
ASSIGNMENT_SERVICE_URL=http://assignment-service:8083/assignment
BLOG_SERVICE_URL=http://blog-service:8084/blog
CHATBOT_SERVICE_URL=http://chatbot-service:8085/chatbot

# ============================================================
# 1. Service Registry (Eureka Server)
# ============================================================
SERVICE_REGISTRY_PORT=8761

# ============================================================
# 2. API Gateway
# ============================================================
SERVER_PORT=8080
API_GATEWAY_PORT=8080
API_GATEWAY_LOG_LEVEL=INFO
API_GATEWAY_LOG_LEVEL_OVERRIDE=INFO
API_GATEWAY_SPRING_CLOUD_GATEWAY_LOG_LEVEL=INFO
API_GATEWAY_REACTOR_NETTY_LOG_LEVEL=INFO

# Khóa bí mật ký token JWT (Tối thiểu 256 bits, thay đổi khi deploy production)
JWT_SIGNER_KEY=replace-with-a-very-secure-jwt-secret-key-at-least-256-bits-long-example

# Resilience4j Circuit Breaker & Timeouts tại Gateway
GATEWAY_CIRCUIT_SLIDING_WINDOW_SIZE=10
GATEWAY_CIRCUIT_MINIMUM_CALLS=5
GATEWAY_CIRCUIT_FAILURE_RATE_THRESHOLD=50
GATEWAY_CIRCUIT_WAIT_DURATION=10s
GATEWAY_CIRCUIT_HALF_OPEN_CALLS=3
GATEWAY_HTTP_CONNECT_TIMEOUT_MS=10000
GATEWAY_HTTP_RESPONSE_TIMEOUT=30s
GATEWAY_CIRCUIT_TIMEOUT=10s
GATEWAY_ASSIGNMENT_CIRCUIT_TIMEOUT=15s
GATEWAY_ASSIGNMENT_AI_CIRCUIT_TIMEOUT=130s
GATEWAY_CHATBOT_CIRCUIT_TIMEOUT=20s
GATEWAY_STORAGE_CIRCUIT_TIMEOUT=15s

GATEWAY_IDENTITY_HEALTH_URI=http://identity-service:8081
GATEWAY_COURSE_HEALTH_URI=http://course-service:8082
GATEWAY_ASSIGNMENT_HEALTH_URI=http://assignment-service:8083
GATEWAY_BLOG_HEALTH_URI=http://blog-service:8084
GATEWAY_CHATBOT_HEALTH_URI=http://chatbot-service:8085

FEIGN_CONNECT_TIMEOUT_MS=10000
FEIGN_READ_TIMEOUT_MS=30000

# ============================================================
# 3. Identity Service
# ============================================================
IDENTITY_SERVICE_PORT=8081
IDENTITY_LOG_LEVEL=INFO
IDENTITY_LOG_LEVEL_OVERRIDE=INFO
IDENTITY_JPA_SHOW_SQL=false
IDENTITY_JPA_SHOW_SQL_OVERRIDE=false

# SMTP Mail Server gửi mã OTP xác thực
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-your-gmail@gmail.com
MAIL_PASSWORD=replace-with-your-gmail-app-password

IDENTITY_URL_DB=jdbc:mysql://mysql:3306/identity_lms?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&createDatabaseIfNotExist=true
IDENTITY_DB_USERNAME=root
IDENTITY_DB_PASSWORD=mysqladmin123

# Thời hạn Token (Tính bằng giây: Access Token 30 phút, Refresh Token 7 ngày)
JWT_ACCESS_DURATION=1800
JWT_REFRESH_DURATION=604800

OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5

# Tài khoản Admin mặc định khi bootstrap hệ thống
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAMES=admin
BOOTSTRAP_ADMIN_PASSWORDS=admin
BOOTSTRAP_ADMIN_EMAILS=admin@lms.edu.vn
BOOTSTRAP_ADMIN_FULLNAMES=System Administrator
BOOTSTRAP_ADMIN_EMAIL_DOMAIN=lms.edu.vn

APP_CLEANUP_CRON=0 0 2 * * *
APP_CLEANUP_ZONE=Asia/Ho_Chi_Minh

# Cấu hình Google OAuth 2.0
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:5173/authenticate

MINIO_IDENTITY_BUCKET=lms-identity-bucket
MINIO_IDENTITY_MAX_FILE_SIZE_BYTES=5242880
MINIO_IDENTITY_PRESIGNED_EXPIRY_MINUTES=5

# ============================================================
# 4. Course Service
# ============================================================
COURSE_SERVICE_PORT=8082
COURSE_LOG_LEVEL=INFO
COURSE_LOG_LEVEL_OVERRIDE=INFO
COURSE_JPA_SHOW_SQL=false
COURSE_JPA_SHOW_SQL_OVERRIDE=false

COURSE_DB_URL=jdbc:mysql://mysql:3306/course_lms?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&createDatabaseIfNotExist=true
COURSE_DB_USERNAME=root
COURSE_DB_PASSWORD=mysqladmin123
COURSE_MONGODB_URI=mongodb://mongoadmin:mongoadmin123@mongodb:27017/course_lms_mongo?authSource=admin

COURSE_MULTIPART_MAX_FILE_SIZE=20MB
COURSE_MULTIPART_MAX_REQUEST_SIZE=25MB

MINIO_BUCKET=lms-course-bucket
COURSE_MINIO_PRESIGNED_EXPIRY_MINUTES=5

GOOGLE_SERVICE_ACCOUNT_FILE=classpath:google-service-account.json
GOOGLE_DELEGATED_EMAIL=
GOOGLE_CALENDAR_ID=primary

# ============================================================
# 5. Assignment Service
# ============================================================
ASSIGNMENT_SERVICE_PORT=8083
ASSIGNMENT_LOG_LEVEL=INFO
ASSIGNMENT_LOG_LEVEL_OVERRIDE=INFO
ASSIGNMENT_JPA_SHOW_SQL=false
ASSIGNMENT_JPA_SHOW_SQL_OVERRIDE=false
ASSIGNMENT_HIBERNATE_GENERATE_STATISTICS=false
ASSIGNMENT_HIBERNATE_GENERATE_STATISTICS_OVERRIDE=false

ASSIGNMENT_DB_URL=jdbc:mysql://mysql:3306/assignment_lms?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&createDatabaseIfNotExist=true
ASSIGNMENT_DB_USERNAME=root
ASSIGNMENT_DB_PASSWORD=mysqladmin123
ASSIGNMENT_MONGODB_URI=mongodb://mongoadmin:mongoadmin123@mongodb:27017/assignment_lms_mongo?authSource=admin

ASSIGNMENT_CHATBOT_FEIGN_CONNECT_TIMEOUT=10000
ASSIGNMENT_CHATBOT_FEIGN_READ_TIMEOUT=120000

# Trình chấm Code (Judge Engine: 'judge0' hoặc 'custom')
JUDGE_ENGINE=judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=replace-with-judge0-api-key
JUDGE0_MAX_POLL_ATTEMPTS=30
JUDGE0_POLL_INTERVAL_MS=2000

CUSTOM_JUDGE_URL=
CUSTOM_JUDGE_API_KEY=
CUSTOM_JUDGE_MAX_POLL_ATTEMPTS=10
CUSTOM_JUDGE_POLL_INTERVAL_MS=2000

QUIZ_AI_SOURCE_CONTENT_MAX_LENGTH=10000
QUIZ_AI_TEST_CASE_MAX_COUNT=50
QUIZ_ABANDONED_THRESHOLD_DAYS=7
QUIZ_CLEANUP_EXPIRED_CRON=0 * * * * *
QUIZ_CLEANUP_ABANDONED_CRON=0 0 * * * *
QUIZ_CLEANUP_PAGE_SIZE=100

ASSIGNMENT_JUDGE_CORE_POOL_SIZE=4
ASSIGNMENT_JUDGE_MAX_POOL_SIZE=8
ASSIGNMENT_JUDGE_QUEUE_CAPACITY=100
ASSIGNMENT_JUDGE_THREAD_NAME_PREFIX=judge-

ASSIGNMENT_SUBMISSION_STUCK_CLEANUP_CRON=0 */5 * * * *
ASSIGNMENT_SUBMISSION_STUCK_THRESHOLD_MINUTES=10
ASSIGNMENT_COUNTER_SYNC_CRON=0 0 3 * * *
ASSIGNMENT_TEST_CASE_IMPORT_MAX_FILE_SIZE_BYTES=10485760

MINIO_ASSIGNMENT_BUCKET=lms-assignment-bucket
MINIO_ASSIGNMENT_MAX_FILE_SIZE_BYTES=5242880
MINIO_ASSIGNMENT_PRESIGNED_EXPIRY_MINUTES=5

# ============================================================
# 6. Blog Service
# ============================================================
BLOG_SERVICE_PORT=8084
BLOG_LOG_LEVEL=INFO
BLOG_LOG_LEVEL_OVERRIDE=INFO
BLOG_JPA_SHOW_SQL=false
BLOG_JPA_SHOW_SQL_OVERRIDE=false

BLOG_DB_URL=jdbc:mysql://mysql:3306/blog_lms?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&createDatabaseIfNotExist=true
BLOG_DB_USERNAME=root
BLOG_DB_PASSWORD=mysqladmin123

BLOG_MULTIPART_MAX_FILE_SIZE=5MB
BLOG_MULTIPART_MAX_REQUEST_SIZE=6MB

MINIO_BLOG_BUCKET=lms-blog-bucket
MINIO_BLOG_MAX_FILE_SIZE_BYTES=5242880
MINIO_BLOG_PUBLIC_READ_ENABLED=true
BLOG_THUMBNAIL_FOLDER=thumbnails

# ============================================================
# 7. Chatbot Service
# ============================================================
CHATBOT_SERVICE_PORT=8085

CHATBOT_MONGO_URI=mongodb://mongoadmin:mongoadmin123@mongodb:27017/chatbot_db?authSource=admin

# Redis cache & rate limiting
CHATBOT_REDIS_HOST=redis
CHATBOT_REDIS_PORT=6379
CHATBOT_REDIS_PASSWORD=redisadmin123
CHATBOT_REDIS_TIMEOUT=5s
CHATBOT_REDIS_TIMEOUT_OVERRIDE=5s
CHATBOT_REDIS_CONNECT_TIMEOUT=3s
CHATBOT_REDIS_POOL_MAX_ACTIVE=30
CHATBOT_REDIS_POOL_MAX_IDLE=5
CHATBOT_REDIS_POOL_MIN_IDLE=0
CHATBOT_REDIS_POOL_MAX_WAIT=5000ms
CHATBOT_REDIS_POOL_EVICTION_INTERVAL=30s

# Cấu hình Large Language Model (LLM Provider)
LLM_PROVIDER=opencode
LLM_API_KEY=replace-with-opencode-api-key
LLM_MODEL=deepseek-v4-flash-free
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_THINKING_TYPE=disabled
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE_CHAT=0.7
LLM_TEMPERATURE_GENERATE=0.3
LLM_MAX_RETRY=3
LLM_RETRY_BACKOFF=5s
LLM_STREAM_TIMEOUT=30s
LLM_GENERATE_TIMEOUT=60s
LLM_RATE_LIMIT_STUDENT=50
LLM_RATE_LIMIT_INSTRUCTOR=100

CHATBOT_WEBCLIENT_MAX_IN_MEMORY_SIZE_BYTES=2097152
CHATBOT_CACHE_TTL_HOURS=24
CHATBOT_CACHE_MAX_MESSAGES=20
CHATBOT_HISTORY_RECENT_LIMIT=20
CHATBOT_HISTORY_RESPONSE_LIMIT=20

CHATBOT_PROMPT_MAX_HISTORY_TOKENS=3000
CHATBOT_PROMPT_EXISTING_TEST_CASES_LIMIT=20
CHATBOT_GENERATE_JSON_PARSE_MAX_RETRY=2
CHATBOT_SESSION_ARCHIVE_CRON=0 0 0 * * *
CHATBOT_SESSION_ARCHIVE_AFTER_DAYS=30
CHATBOT_SESSION_TITLE_MAX_LENGTH=50

CHATBOT_LOG_LEVEL=INFO
CHATBOT_LOG_LEVEL_OVERRIDE=INFO

# ============================================================
# 8. Frontend Application (Vite + React)
# ============================================================
VITE_API_BASE_URL=http://localhost:8080
VITE_API_TIMEOUT_MS=15000
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/authenticate
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
VITE_PUBLIC_IP_API_URL=https://api.ipify.org?format=json
VITE_PUBLIC_IP_TIMEOUT_MS=3000

# Health check endpoints phía Frontend
VITE_GATEWAY_HEALTH_URL=http://localhost:8080/actuator/health/liveness
VITE_IDENTITY_HEALTH_URL=http://localhost:8081/identity/actuator/health
VITE_COURSE_HEALTH_URL=http://localhost:8082/course/actuator/health/liveness
VITE_ASSIGNMENT_HEALTH_URL=http://localhost:8083/assignment/actuator/health/liveness
VITE_BLOG_HEALTH_URL=http://localhost:8084/blog/actuator/health/liveness
VITE_CHATBOT_HEALTH_URL=http://localhost:8085/chatbot/actuator/health/liveness
VITE_ADMIN_HEALTH_TIMEOUT_MS=5000
VITE_ADMIN_HEALTH_IDENTITY_TIMEOUT_MS=12000
VITE_ADMIN_HEALTH_REFRESH_INTERVAL_MS=30000


# ============================================================
# 9. E2E Test Suite Configurations (Không commit credentials thật)
# ============================================================
SMOKE_ADMIN_USERNAME=replace-with-admin-username
SMOKE_ADMIN_PASSWORD=replace-with-admin-password
