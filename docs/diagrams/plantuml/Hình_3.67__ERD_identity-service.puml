@startuml
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
hide footbox
title 3.67 — ERD identity-service
top to bottom direction
hide circle
skinparam linetype ortho
entity "users" as users {
user_id : CHAR(36)
user_name : VARCHAR(55)
email : VARCHAR(255)
password_hash : VARCHAR(255)
full_name : VARCHAR(255)
dob : DATE
avatar_url : VARCHAR(500)
bio : TEXT
phone : VARCHAR(20)
role : ENUM('ADMIN','INSTRUCTOR','STUDENT')
role_selected : TINYINT(1)
is_active : TINYINT(1)
is_verified : TINYINT(1)
auth_provider : ENUM('LOCAL','GOOGLE')
provider_id : VARCHAR(100)
last_login_at : DATETIME
created_at : DATETIME
updated_at : DATETIME
}
entity "refresh_tokens" as refresh_tokens {
token_id : CHAR(36)
user_id : CHAR(36)
token_hash : VARCHAR(64)
device_info : VARCHAR(255)
ip_address : VARCHAR(45)
expires_at : DATETIME
is_revoked : TINYINT(1)
created_at : DATETIME
}
entity "email_verifications" as email_verifications {
id : BIGINT
user_id : CHAR(36)
token : VARCHAR(255)
type : ENUM('VERIFY_EMAIL','RESET_PASSWORD')
expires_at : DATETIME
used_at : DATETIME
attempts : TINYINT
created_at : DATETIME
}
users ||--o{ refresh_tokens : "user_id -> user_id"
users ||--o{ email_verifications : "user_id -> user_id"
legend bottom
Đường liền: FK khai báo trong migration V1.
ID xuyên service, MongoDB và votes.target_id không tự có FK.
PK/unique/default và V2 xem từ điển dữ liệu trong tab báo cáo.
endlegend
@enduml